// 80
pow:
    enter 8, 2;
	push 8, 1; // result
	push 8, 0; // counter
	prsp 8, 1; // limit
	loop:
		cmp 8; // compare the counter and the limit, jump to end if zero
		jnz end;
		prsp 8, 0; // load the base
		prsp 8, 2; // load the result
		mul 8;
		lrsp 8, 2;
		push 8, 1;
		sub 8;
		jmp loop;
	end:
		prsp 8, 2; // push the result to top
		ret 8;
start:
	push 8, 2;
	push 8, 7;
	call pow;
	print 8;
