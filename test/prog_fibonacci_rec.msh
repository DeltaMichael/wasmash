fib:
  enter 8, 1;
  push 8, 0;
  cmp 8;
  pop 8;
  jnz base;
  push 8, 1;
  cmp 8;
  pop 8;
  jnz base;
  jmp com;
base:
  push 8, 1;
  ret 8;
com:
  prsp 8, 0;
  push 8, 1;
  sub 8;
  call fib;
  prsp 8, 0;
  push 8, 2;
  sub 8;
  call fib;
  prt 8, 2;
  add 8,;
  ret 8;

start:
  push 8, 0;
  call fib;
  print 8;
  push 8, 1;
  call fib;
  print 8;
  push 8, 2;
  call fib;
  print 8;
  push 8, 3;
  call fib;
  print 8;
  push 8, 4;
  call fib;
  print 8;
  push 8, 5;
  call fib;
  print 8;
  push 8, 6;
  call fib;
  print 8;
  push 8, 7;
  call fib;
  print 8;
  push 8, 8;
  call fib;
  print 8;
  push 8, 9;
  call fib;
  print 8;
