fib:
  enter8 1;
  push8 0;
  cmp8;
  pop8;
  jnz8 base;
  push8 1;
  cmp8;
  pop8;
  jnz8 base;
  jmp8 com;
base:
  push8 1;
  ret8;
com:
  prsp8 0;
  push8 1;
  sub8;
  call fib;
  prsp8 0;
  push8 2;
  sub8;
  call fib;
  prt8 2;
  add8;
  ret8;

start:
  push8 0;
  call fib;
  print8;
  push8 1;
  call fib;
  print8;
  push8 2;
  call fib;
  print8;
  push8 3;
  call fib;
  print8;
