lrel8 0; // change value at stack pointer to equal value at top $sp = 4
ltop8 0; // load value at stack pointer on top, i.e. push 4 to top
print8;
ltop8 2; // load value at stack pointer + 2 on top, i.e. push 3 to top 
print8;